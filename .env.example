# Public browser configuration. Use separate values for Preview and Production.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Must match the approved admin authorization source and public.app_admins.
# Never rename this to NEXT_PUBLIC_ALLOWED_ADMIN_EMAIL.
ALLOWED_ADMIN_EMAIL=

# Cloudflare Turnstile: site key is public; secret is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional server-only contact delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
