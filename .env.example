NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Single admin allowlist — must match public.app_admins.
# Do not put this in NEXT_PUBLIC_* (keeps the admin email off the client bundle).
ALLOWED_ADMIN_EMAIL=

# Cloudflare Turnstile (contact form). Site key is public; secret is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: deliver contact form messages
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
